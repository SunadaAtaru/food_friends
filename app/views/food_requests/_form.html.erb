<%# app/views/food_requests/_form.html.erb %>
<%= form_with(model: [food_post, food_request], local: true) do |f| %>
  
  <div class="alert alert-info mb-3">
    <small><i class="bi bi-info-circle"></i> メッセージか希望受け取り時間のいずれかを必ず入力してください</small>
  </div>
  
  <div class="form-group mb-3">
    <%= f.label :message, "メッセージ", class: "form-label" %>
    <%= f.text_area :message, class: "form-control", placeholder: "メッセージを入力してください", rows: 3 %>
  </div>
  
  <% if food_request.new_record? %>
    <%# 新規リクエストの場合は希望受け取り時間フィールドを表示 %>
    <div class="form-group mb-3">
      <%= f.label :pickup_time, "希望受け取り時間", class: "form-label" %>
      <%= f.datetime_local_field :pickup_time, class: "form-control" %>
    </div>
  <% end %>
  
  <div class="d-grid gap-2 d-md-flex justify-content-md-end">
    <%= f.submit submit_text, class: "btn btn-primary" %>
  </div>
<% end %>